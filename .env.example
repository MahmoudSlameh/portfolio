APP_NAME="Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev uses SQLite; production uses MySQL 8:
# DB_CONNECTION=mysql
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Portfolio
ADMIN_NAME="Admin"
ADMIN_EMAIL=mahmoud@admin.com
ADMIN_PASSWORD=123123123
# Comma-separated emails allowed into /admin in production
ADMIN_EMAILS="${ADMIN_EMAIL}"
# Developer template gallery at /dev/templates (defaults to on when APP_ENV=local)
# TEMPLATE_GALLERY=false
MEDIA_DISK=public

# AI template builder (docs/12-ai-templates.md). Site → AI in the panel overrides these.
# Provider: anthropic, openai, gemini, xai, mistral, deepseek, groq, openrouter, ollama, openai-compatible
STUDIO_AI_PROVIDER=
# Empty = the provider's default model
STUDIO_AI_MODEL=
# STUDIO_AI_DAILY_LIMIT=20
# STUDIO_AI_MAX_TOKENS=16000
# STUDIO_AI_TIMEOUT=240
# Optional: screenshots of studio templates for the Appearance cards (else a colour swatch).
# Also used to turn an SVG favicon into favicon.ico / PNG icons (php artisan site:favicons).
# STUDIO_SCREENSHOT_CHROME=/usr/bin/chromium
# STUDIO_SCREENSHOT_URL=http://127.0.0.1   # how the server reaches the site, if not APP_URL
# STUDIO_SCREENSHOT_NO_SANDBOX=false       # true only when the queue worker runs as root
# Provider keys use the Laravel AI SDK's names; set only the one you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_URL=http://localhost:11434
# OPENAI_COMPATIBLE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# Claude connector: MCP server at /mcp (docs/13-mcp-connector.md). Manage it on Site → Claude connector.
# MCP_ENABLED=true
# MCP_RATE_LIMIT=120                 # requests per minute and user
# MCP_TOKEN_DAYS=365                 # lifetime of personal access tokens
# MCP_UPLOAD_MINUTES=15              # lifetime of a request_image_upload URL
# MCP_REDIRECT_DOMAINS="https://claude.ai,https://claude.com,http://localhost,http://127.0.0.1"
# MCP_ALLOW_PRIVATE_URLS=false       # local development only: let Claude fetch/screenshot localhost
# OAuth keys: `php artisan passport:keys` writes storage/oauth-*.key, or set them here
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
